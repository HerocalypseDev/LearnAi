# Copy to .env.local for local development. On Vercel, add these under
# Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (starts with sb_secret_) or the legacy service_role key. Never share it.
SUPABASE_SECRET_KEY=

# Any random string of 32+ characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Your first admin password. Used once on your first login, then stored hashed.
# You can change your password on the admin page afterwards.
ADMIN_PASSWORD=
